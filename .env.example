# Copy to .env locally, or merge into /home/ubuntu/bookme/.env on EC2.
# Never overwrite an existing production .env or change existing DB credentials blindly.
POSTGRES_DB=bookme
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
# Optional override; normally Compose uses jdbc:postgresql://db:5432/bookme.
# DB_URL=jdbc:postgresql://db:5432/bookme

# Base64-encoded random signing key (at least 32 random bytes). Required.
JWT_SECRET_KEY=

AWS_S3_BUCKET_NAME=bookme-app-storage
AWS_S3_REGION=eu-north-1
# Leave credentials empty when an EC2 instance role supplies S3 access.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_S3_PRESIGNED_URL_DURATION_MINUTES=30
# Defaults to dev locally, prod in the production Compose file.
# APP_STORAGE_PREFIX=prod
RATINGLIMIT_TOKENINBUCKET=10
RATINGLIMIT_DURATION=1

# Enable smart filters with google-genai and a Gemini Developer API key.
# none lets the application start without AI; smart filters then return HTTP 503.
AI_CHAT_PROVIDER=none
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AI_MAX_OUTPUT_TOKENS=512
AI_TIMEOUT_MS=20000

DOCKERHUB_USERNAME=braxon2
# Normally supplied by CI as the exact Git commit SHA.
# APP_VERSION=latest
